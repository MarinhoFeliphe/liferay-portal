Bundle-Name: Liferay AI Hub API
Bundle-SymbolicName: com.liferay.ai.hub.api
Bundle-Version: 1.0.0
Export-Package:\
	com.liferay.ai.hub.embedding.store,\
	com.liferay.ai.hub.mcp.tool.provider
Import-Package:\
	!org.bouncycastle.jsse.*,\
	\
	!org.conscrypt.*,\
	\
	!org.openjsse.javax.net.ssl.*,\
	!org.openjsse.net.ssl.*,\
	\
	android.*;resolution:=optional,\
	\
	*
Web-ContextPath: /ai-hub-api
-fixupmessages: Classes found in the wrong directory: ...;is:=ignore